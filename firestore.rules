rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Checks if request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if document ID belongs to correct pattern
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Users Collection Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if true; // Allow anyone to request a registration account
      allow update, delete: if isSignedIn();
    }

    // 3. Vehicles Collection Rules
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Requests Collection Rules
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 5. Blocks Collection Rules
    match /blocks/{blockId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
